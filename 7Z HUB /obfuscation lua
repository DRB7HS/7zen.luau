local function HandlePrompt(prompt)
    if autoGrabEnabled and prompt:IsA("ProximityPrompt") and prompt.Enabled then
        local actionText = prompt.ActionText:lower()
        local objectText = prompt.ObjectText:lower()
        if actionText:find("grab") or objectText:find("grab") or actionText:find("steal") or objectText:find("steal") or actionText:find("take") or objectText:find("take") or actionText == "" then
            if not activeHolds[prompt] then
                activeHolds[prompt] = true
                task.spawn(function()
                    if fireproximityprompt then
                        while autoGrabEnabled and prompt and prompt.Parent and prompt.Enabled do
                            fireproximityprompt(prompt)
                            task.wait(0.05)
                        end
                    else
                        local holdTime = prompt.HoldDuration > 0 and prompt.HoldDuration or 0.1
                        local startTime = tick()
                        
                        prompt:InputHoldBegin()
                        
                        while autoGrabEnabled and prompt and prompt.Parent and prompt.Enabled and (tick() - startTime < holdTime + 0.05) do
                            task.wait(0.01)
                        end
                        
                        if prompt and prompt.Parent then
                            prompt:InputHoldEnd()
                        end
                    end
                    
                    activeHolds[prompt] = nil
                end)
            end
        end
    end
end

