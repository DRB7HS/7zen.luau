            if settingsData.autoGrab ~= nil then ToggleAutoGrab(settingsData.autoGrab) end
            if settingsData.antiLag ~= nil then ToggleAntiLag(settingsData.antiLag) end
            if settingsData.antiKick ~= nil then ToggleAntiKick(settingsData.antiKick) end
            if settingsData.antiRagdoll ~= nil then ToggleAntiRagdoll(settingsData.antiRagdoll) end
            if settingsData.infJump ~= nil then ToggleInfiniteJump(settingsData.infJump) end
            if settingsData.invisible ~= nil then ToggleInvisiblePlayer(settingsData.invisible) end
            if settingsData.unWalk ~= nil then ToggleUnwalk(settingsData.unWalk) end
            if settingsData.xrayBase ~= nil then ToggleXRayBase(settingsData.xrayBase) end
        end)
    end
end

LoadSettings()

local TargetWidth = 380
local TargetHeight = 320
local MinimizedHeight = 48

MainFrame.Size = UDim2.new(0, 0, 0, 0)
MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)

local OpenTweenInfo = TweenInfo.new(0.8, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local OpenTween = TweenService:Create(MainFrame, OpenTweenInfo, {
    Size = UDim2.new(0, TargetWidth, 0, TargetHeight),
    Position = UDim2.new(0.5, 0, 0.5, 0)
})
OpenTween:Play()

local isMinimized = false

ToggleButton.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    local TargetSize
    
    if isMinimized then
        ToggleButton.Text = "+"
        ContentContainer.Visible = false
        TargetSize = UDim2.new(0, TargetWidth, 0, MinimizedHeight)
    else
        ToggleButton.Text = "-"
        ContentContainer.Visible = true
        TargetSize = UDim2.new(0, TargetWidth, 0, TargetHeight)
    end

    local ToggleTweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    local ToggleTween = TweenService:Create(MainFrame, ToggleTweenInfo, {Size = TargetSize})
    ToggleTween:Play()
end)

local dragging = false
local dragInput, dragStart, startPos

local function update(input)
    local delta = input.Position - dragStart
    MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)
