    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 9
    lbl.ZIndex = 2
    CreateTextGlowStroke(lbl)

    local box = Instance.new("TextBox", content)
    box.Size = UDim2.new(0.35, 0, 0, 18)
    box.Position = UDim2.new(0.65, 0, 0, y)
    box.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
    box.Text = tostring(Values[key])
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.Font = Enum.Font.GothamBold
    box.TextSize = 9
    box.ZIndex = 2
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 3)
    CreateMainBorderStroke(box)
    CreateTextGlowStroke(box)

    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n then
            n = math.clamp(n, 10, 200)
            Values[key] = n
            box.Text = tostring(n)
            saveConfig()
        else
            box.Text = tostring(Values[key])
        end
    end)
end

